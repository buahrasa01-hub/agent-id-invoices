# Copy to web/.env.local (never commit it).

# Which networks the app offers, comma-separated. The first is the default; with more than one,
# a switcher appears in the header.
#   bsc-testnet = BNB Smart Chain testnet (chain 97)
#   bsc         = BNB Smart Chain mainnet (chain 56)
#   fork        = `make fork`: local copy of BSC testnet on 127.0.0.1:8555 (chain 97097)
#   local       = `make anvil`: empty local chain on 127.0.0.1:8545 (chain 31337)
NEXT_PUBLIC_NETWORKS=bsc-testnet

# Your AgentIDInvoice on each network (printed by `make deploy-testnet`, `make deploy-mainnet`,
# `make deploy-fork`, `make deploy-local`).
NEXT_PUBLIC_INVOICE_BSC_TESTNET=
NEXT_PUBLIC_INVOICE_BSC_MAINNET=
NEXT_PUBLIC_INVOICE_FORK=
NEXT_PUBLIC_INVOICE_LOCAL=

# Optional. Only scan events from this block onward on the Activity page (speeds it up).
NEXT_PUBLIC_DEPLOY_BLOCK_BSC_TESTNET=
NEXT_PUBLIC_DEPLOY_BLOCK_BSC_MAINNET=
NEXT_PUBLIC_DEPLOY_BLOCK_FORK=

# Optional. Enables WalletConnect (mobile wallets via QR). Free at https://cloud.reown.com
# Without it the app still works with browser-extension wallets (MetaMask, Rabby, …).
NEXT_PUBLIC_WC_PROJECT_ID=

# Optional. Where the Docs page's "Source" link and clone command point (your fork, a preview repo…).
# Default: https://github.com/buahrasa01-hub/agent-id-invoices
NEXT_PUBLIC_REPO_URL=https://github.com/buahrasa01-hub/agent-id-invoices
